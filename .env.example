# ============================================================
# JobSkill Career Advisor — environment template
# Copy to .env and fill in your values.
# ============================================================

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Weaviate (required for vector search)
WEAVIATE_URL=http://localhost:8080
HYBRID_ALPHA=0.6

# LangSmith (optional — tracing & evaluation)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=jobskill-advisor-dev

# OpenAI — only used as RAGAS judge for offline evaluation
OPENAI_API_KEY=sk-proj-...

# ============================================================
# STEP 1 — Choose your inference and embedding providers
# ============================================================
#   fireworks  → Fireworks AI    (fast, cheap, parallel requests)
#   openrouter → OpenRouter      (multi-model router, easy swapping)
#   ollama     → Local Ollama    (no API key, full privacy)
#
# EMBEDDING_PROVIDER defaults to INFERENCE_PROVIDER if omitted.
# Keeping embeddings on Ollama while using Fireworks for chat is
# a good default — embeddings are cached so latency matters less.
# ============================================================

INFERENCE_PROVIDER=fireworks
EMBEDDING_PROVIDER=ollama

# ============================================================
# STEP 2 — Set model names for your chosen provider
# Uncomment the block that matches your INFERENCE_PROVIDER.
# ============================================================

# ------------------------------------------------------------
# Fireworks AI  →  https://fireworks.ai/models
# Fast parallel inference — 3 concurrent generation requests
# complete in roughly the same wall-clock time as 1.
# ------------------------------------------------------------
CHAT_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
PLANNER_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
CRITIQUE_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Other Fireworks chat options:
# CHAT_MODEL=accounts/fireworks/models/deepseek-v3                   # strong reasoning
# CHAT_MODEL=accounts/fireworks/models/qwen3-235b-a22b               # mixture-of-experts
# CHAT_MODEL=accounts/fireworks/models/mixtral-8x22b-instruct        # fast MoE
# CHAT_MODEL=accounts/fireworks/models/llama-v3p1-405b-instruct      # largest Llama

# Fireworks embedding options:
# EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5                         # 768-dim, fast
# EMBED_MODEL=thenlper/gte-large                                      # 1024-dim

# ------------------------------------------------------------
# OpenRouter  →  https://openrouter.ai/models
# Routes to many providers; great for model comparison.
# ------------------------------------------------------------
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
# CHAT_MODEL=meta-llama/llama-3.1-405b-instruct
# CHAT_MODEL=deepseek/deepseek-chat-v3-0324
# CHAT_MODEL=anthropic/claude-sonnet-4-6
# CHAT_MODEL=google/gemini-2.5-flash
# PLANNER_MODEL=meta-llama/llama-3.1-8b-instruct
# CRITIQUE_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter embedding options:
# EMBED_MODEL=openai/text-embedding-3-small                          # 1536-dim
# EMBED_MODEL=openai/text-embedding-3-large                          # 3072-dim

# ------------------------------------------------------------
# Ollama (local)  →  ollama.com/library
# No API key needed.  Run: ollama pull <model>
# ------------------------------------------------------------
# CHAT_MODEL=llama3.2
# CHAT_MODEL=llama3.1:8b
# CHAT_MODEL=mistral
# CHAT_MODEL=deepseek-r1:7b
# PLANNER_MODEL=llama3.2                 # same or a smaller/faster model
# CRITIQUE_MODEL=deepseek-r1:1.5b       # reasoning model reduces self-bias

# Ollama embedding options:
# EMBED_MODEL=nomic-embed-text           # 768-dim, recommended
# EMBED_MODEL=mxbai-embed-large          # 1024-dim

# ============================================================
# STEP 3 — API keys (only needed for cloud providers)
# ============================================================

FIREWORKS_API_KEY=fw_...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_URL=http://localhost:11434

# ============================================================
# RETRIEVAL TUNING
# ============================================================
RETRIEVAL_TOP_K_JOBS=5
RETRIEVAL_TOP_K_COURSES=5
